# Copy to .env and edit.
ENV=development                # anything except "production" also serves /docs
LOG_LEVEL=INFO
API_PORT=8000

# Comma-separated keys accepted in the X-API-Key header. Empty = auth disabled (local dev only).
API_KEYS=dev-key
# Frontend origins allowed by CORS, comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

MAX_UPLOAD_MB=15
MAX_BATCH_FILES=10
CONCURRENCY=2
DATE_ORDER=MDY                 # how to read ambiguous 04/05/2020: MDY (US) or DMY
REVIEW_THRESHOLD=0.80

# --- LLM fallback (Gemini). Leave GEMINI_API_KEY empty to run rules-only.
GEMINI_API_KEY=
LLM_MODE=auto                  # auto: only when the rules result is unreliable | always | off
LLM_MODEL=gemini-3.5-flash-lite   # model ids retire: if you see 404 NOT_FOUND in the logs, pick a current one
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=30
# Quota guard. Requests above these are never sent (rolling minute, and per day resetting at midnight Pacific).
LLM_RPM=10
LLM_RPD=20

LOG_FORMAT=json                # json for production log collectors, text for readable local output
