meta {
  name: Extract batch (up to 10)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/extract/batch
  body: multipartForm
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:multipart-form {
  files: @file(samples/invoice_seller_client.jpg)
  files: @file(samples/invoice_freeform.jpg)
}

tests {
  test("one result per file", function() {
    expect(res.status).to.equal(200);
    expect(res.body.results).to.have.length(2);
    expect(res.body.results.every(r => r.ok)).to.equal(true);
  });
}
